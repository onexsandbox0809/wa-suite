# ---------------------------------------------------------------------------
# Single Supabase project, shared by both the link shortener (links, clicks
# tables) and the campaign manager (campaigns table).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-project-service-role-key

# Used to build short_url in API responses. If blank, the app infers it from
# the incoming request host header.
NEXT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Onexaura media upload
# ---------------------------------------------------------------------------
ONEXAURA_API_KEY=your-onexaura-api-key
ONEXAURA_PHONE_NUMBER=919217090193
